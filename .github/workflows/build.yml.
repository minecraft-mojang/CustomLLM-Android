name: Build Android APK from zip
on:
  push:
    branches: [main, master]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Unzip project
        run: |
          ZIP=$(find . -maxdepth 2 -name '*.zip' -not -path './.git/*' | head -n1)
          [ -n "$ZIP" ] || { echo "No .zip found in the repo"; exit 1; }
          echo "Using $ZIP"
          mkdir -p /tmp/proj && unzip -q "$ZIP" -d /tmp/proj
          GRADLE_FILE=$(find /tmp/proj -name settings.gradle.kts -not -path '*/__MACOSX/*' | head -n1)
          [ -n "$GRADLE_FILE" ] || { echo "settings.gradle.kts not found inside the zip"; exit 1; }
          echo "PROJ=$(dirname "$GRADLE_FILE")" >> "$GITHUB_ENV"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - uses: android-actions/setup-android@v3

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7

      # Bundle TensorFlow.js into the APK so the app works offline
      - name: Download TF.js into assets
        run: |
          A="$PROJ/app/src/main/assets"
          curl -fL https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.22.0/dist/tf.min.js -o "$A/tf.min.js" || echo "tf.min.js not bundled (CDN fallback)"
          curl -fL https://cdn.jsdelivr.net/npm/@tensorflow/tfjs-backend-webgpu@4.22.0/dist/tf-backend-webgpu.min.js -o "$A/tf-backend-webgpu.min.js" || echo "webgpu backend not bundled (CDN fallback)"

      - name: Build debug APK
        working-directory: ${{ env.PROJ }}
        run: gradle assembleDebug --stacktrace

      - uses: actions/upload-artifact@v4
        with:
          name: LLMLab-debug-apk
          path: ${{ env.PROJ }}/app/build/outputs/apk/debug/*.apk
